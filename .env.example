# Copy to .env and fill in. Never commit .env.

# ── ElevenLabs (voice, sound design, music) ────────────────────────────────
ELEVENLABS_API_KEY=

# Default voice for episodes that do not set voice.voiceId.
# Must belong to the workspace that owns ELEVENLABS_API_KEY — check with
# `npm run vo -- --list`, which prints only voices this key can use.
ELEVENLABS_VOICE_ID=

# Optional overrides
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_TTS_FORMAT=mp3_44100_128
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ── Zernio (publishing) ───────────────────────────────────────────────────
# Create a key at https://zernio.com/dashboard/api-keys — it starts with sk_,
# is 67 characters, and is shown only once. One key covers every platform.
ZERNIO_API_KEY=
# ZERNIO_BASE_URL=https://zernio.com/api/v1
