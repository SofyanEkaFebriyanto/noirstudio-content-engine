{
  "id": "launch-30s",
  "label": "Launch — 30 seconds, vertical",
  "format": "reel",
  "theme": "noir",
  "description": "Cold open on the finished result, one problem line, the thing doing its job, one differentiator, CTA. The default product launch shape.",
  "structure": "B",
  "scenes": [
    {
      "id": "open",
      "shot": "brand-open",
      "durationInFrames": 66,
      "props": {
        "line": "EPISODE 01",
        "particles": 30
      }
    },
    {
      "id": "promise",
      "shot": "big-statement",
      "durationInFrames": 150,
      "props": {
        "kicker": "The result first",
        "lines": [
          "It already *works*.",
          "Here is how."
        ]
      },
      "transition": {
        "type": "fade",
        "durationInFrames": 12
      }
    },
    {
      "id": "problem",
      "shot": "title-card",
      "durationInFrames": 126,
      "props": {
        "eyebrow": "The problem",
        "title": "Hand editing does not *scale*.",
        "subtitle": "Every platform needs the same change, separately."
      },
      "transition": {
        "type": "slide",
        "durationInFrames": 12,
        "direction": "from-right"
      }
    },
    {
      "id": "show",
      "shot": "footage-fill",
      "durationInFrames": 310,
      "props": {
        "kicker": "Live",
        "headline": "Watch it *run*.",
        "caption": "Replace this clip with your product doing the job.",
        "kenBurns": 0.05,
        "scrim": 0.4
      },
      "transition": {
        "type": "wipe",
        "durationInFrames": 14,
        "direction": "from-left"
      }
    },
    {
      "id": "different",
      "shot": "compare-split",
      "durationInFrames": 162,
      "props": {
        "heading": "What is different",
        "left": {
          "label": "Others",
          "title": "More to manage",
          "points": [
            "New tool to learn",
            "Another dashboard",
            "Another bill"
          ]
        },
        "right": {
          "label": "Ours",
          "title": "One file",
          "points": [
            "Everything in the spec",
            "Re-render, not re-edit",
            "Ship from the repo"
          ]
        },
        "winner": "right"
      },
      "transition": {
        "type": "fade",
        "durationInFrames": 12
      }
    },
    {
      "id": "close",
      "shot": "end-card",
      "durationInFrames": 150,
      "props": {
        "line": "Start with one episode.",
        "cta": "Follow the build",
        "handle": "@noirstudio"
      },
      "transition": {
        "type": "fade",
        "durationInFrames": 14
      }
    }
  ],
  "voice": {
    "_note": "Write the narration after the visual skeleton reads correctly. ~2.5 words per second.",
    "segments": []
  },
  "captions": {
    "mode": "words",
    "style": "kinetic",
    "windowWords": 5
  },
